<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>depth_perception</name>
  <version>0.1.0</version>
  <description>Depth perception node — gate-aware 3-D estimation for SAUVC AUV</description>

  <maintainer email="ycchiu226@gmail.com">ycchiu226</maintainer>
  <license>Apache-2.0</license>

  <!-- build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- shared message interfaces -->
  <depend>orca_interface</depend>

  <!-- standard message dependencies -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- runtime -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
