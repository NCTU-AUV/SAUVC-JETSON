<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orca_perception</name>
  <version>0.1.0</version>
  <description>SAUVC AUV unified perception pipeline launcher</description>

  <maintainer email="ycchiu226@gmail.com">ycchiu226</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- runtime dependencies (launch-time) -->
  <exec_depend>camera_selector</exec_depend>
  <exec_depend>depth_perception</exec_depend>
  <exec_depend>isaac_ros_yolov8</exec_depend>
  <exec_depend>isaac_ros_tensor_rt</exec_depend>
  <exec_depend>isaac_ros_dnn_image_encoder</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
