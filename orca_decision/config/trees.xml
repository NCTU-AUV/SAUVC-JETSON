<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <!-- The transit depth is the caller's business, not this subtree's. There used
       to be a hardcoded <SetDepth depth="0.2"/> here, which silently overwrote
       whatever depth FinalMission had just set: SetDepth is a SyncActionNode
       that publishes once and returns, with no restore, so entering this subtree
       snapped the vehicle back to 0.2 m and defeated both the 0.7 m and the
       1.1 m transits. It was invisible in QualificationMission because that
       mission also uses 0.2.

       All three call sites already run SetDepth immediately before entering, so
       the line was redundant as well as harmful — dropping it is the whole fix.
       (A subtree port was the obvious alternative and does not work: in
       BT.CPP v3 a SubTree attribute remaps onto a parent blackboard *key*, not
       a literal, so depth="{transit_depth}" resolves to nothing and the node
       aborts at the first tick with "missing required input [depth]".) -->
  <BehaviorTree ID="PassGateProcedure">
    <Sequence>
      <RetryUntilSuccessful num_attempts="30">
        <Sequence>
          <SearchTarget label="gate"/>
          <!-- ApproachTarget only ever returns SUCCESS (close enough) or
               FAILURE (target lost / depth never resolved). If it converges to
               just outside `distance` it stays RUNNING, and RetryUntilSuccessful
               only fires on FAILURE — so without a Timeout the mission hangs
               with no diagnostic. Expiry halts the node and retries from
               SearchTarget, which is the right recovery. -->
          <Timeout msec="60000">
            <ApproachTarget label="gate" distance="3.0"/>
          </Timeout>
          <FinalAlignTarget label="gate"/>
        </Sequence>
      </RetryUntilSuccessful>
      <BlindForward duration="20.0" heading_lock="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="QualificationMission">
    <Sequence>
      <!-- WaitForStart is simulated by the decision node triggering BT tick based on topic -->
      <SetCamera mode="realsense"/>
      <SetDepth depth="0.2"/>

      <ReactiveFallback>
        <AvoidObstacle/>
        <SubTree ID="PassGateProcedure"/>
      </ReactiveFallback>

      <!-- Turn 180 degrees relative to current yaw -->
      <TurnToYaw degrees="180"/>

      <BlindForward duration="15.0" heading_lock="true"/>
      <SetDepth depth="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FinalMission">
    <Sequence>
      
      <SetCamera mode="realsense"/>
      <SetDepth depth="0.7"/>

      <ReactiveFallback>
        <AvoidObstacle sticky_time="1.0"/>
        <SubTree ID="PassGateProcedure"/>
      </ReactiveFallback>

      <SetDepth depth="0.5"/>
      <SubTree ID="TargetAcquisition" drop_pose="{drop_pose}"/>

      <SetCamera mode="realsense"/>
      <SetDepth depth="1.1"/>
      <SubTree ID="PassGateProcedure"/>

      <SubTree ID="CommunicationTask"/>

      <SetDepth depth="0.5"/>
      <SubTree ID="TargetReacquisition" drop_pose="{drop_pose}"/>

      <FinishMission/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TargetAcquisition">
    <Sequence>
      <SetCamera mode="realsense"/>
      <RetryUntilSuccessful num_attempts="60">
        <Sequence>
          <SearchTarget label="blue_drum"/>
          <Timeout msec="60000">
            <ApproachTarget label="blue_drum" distance="4.0"/>
          </Timeout>
          <FinalAlignTarget label="blue_drum"/>
        </Sequence>
      </RetryUntilSuccessful>
      <SetCamera mode="usb"/>
      <MoveAboveTarget label="blue_drum"/>
      <DropBall/>
      <CheckBottomClear/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CommunicationTask">
    <Sequence>
      <WaitForFlareOrder/>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_1}"/>
              </Timeout>
              <Timeout msec="45000">
                <ApproachTarget label="{flare_1}" distance="0.5"/>
              </Timeout>
              <FinalAlignTarget label="{flare_1}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_2}"/>
              </Timeout>
              <Timeout msec="45000">
                <ApproachTarget label="{flare_2}" distance="0.5"/>
              </Timeout>
              <FinalAlignTarget label="{flare_2}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_3}"/>
              </Timeout>
              <Timeout msec="45000">
                <ApproachTarget label="{flare_3}" distance="0.5"/>
              </Timeout>
              <FinalAlignTarget label="{flare_3}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TargetReacquisition">
    <Sequence>
      <SetCamera mode="realsense"/>
      <GoToPose pose_key="drop_pose"/>
      <SetCamera mode="usb"/>
      <RetryUntilSuccessful num_attempts="100">
        <Fallback>
          <Sequence>
            <SearchBottomTarget label="ball"/>
            <MoveAboveTarget label="ball"/>
            <ExtendArm/>
            <GrabBall/>
            <RetractArm/>
          </Sequence>
          <ForceFailure>
            <SpiralSearchBottom/>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <!-- ==========================================================================
       新生實作區

       上面的樹是比賽在跑的，不要改。你的作業寫在這條線以下。
       完整說明：docs/FRESHMAN_QUAL_TASK.md
       ========================================================================== -->

  <!-- 方案 A：只改這份 XML，不寫任何 C++。
       資格賽的動作序列是「下潛 → 直行過閘門 → 上浮」，三個動作都已經有現成
       的節點可以用，你的工作是把它們照順序組起來。

       可以用的積木（括號內是必填屬性）：
         <SetDepth depth="0.5"/>                        設定目標深度，公尺，發完就結束
         <BlindForward duration="15.0" heading_lock="true"/>  盲走前進幾秒，不依賴視覺
         <TurnToYaw degrees="180"/>                     相對現在的航向轉幾度

       <Sequence> 的語意：由左到右依序執行，前一個回 SUCCESS 才會輪到下一個；
       任何一個 FAILURE 整串就中止。想知道還有哪些節點可以用，就往上翻
       QualificationMission —— 那是同一個任務的正式版本。 -->
  <BehaviorTree ID="StudentSimpleQualMission">
    <Sequence>
      <!-- TODO(A-1)：下潛到 0.5 公尺 -->

      <!-- TODO(A-2)：盲走前進 15 秒，並鎖住航向（不然會歪） -->

      <!-- 上浮回水面。深度 0 就是水面，這行已經幫你寫好了 —— 它同時也是
           「Sequence 至少要有一個子節點」的保證，把它刪掉整份 XML 會載不進去。 -->
      <SetDepth depth="0.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- 方案 B：用你自己寫的 C++ 節點。

       ★ 先完成 main.cpp 的 TODO(5) 把 StudentQualTask 註冊起來，再把下面這段
         取消註解。順序反了的話，BT.CPP 在載入 XML 時就會因為不認得
         <StudentQualTask> 而讓**整份 trees.xml** 載入失敗，連比賽用的樹都起不來。

  <BehaviorTree ID="StudentMission">
    <Sequence>
      <StudentQualTask duration="15.0" target_depth="0.5"/>
    </Sequence>
  </BehaviorTree>

  -->

</root>
