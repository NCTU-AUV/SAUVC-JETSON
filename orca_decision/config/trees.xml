<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3">
  <BehaviorTree ID="PassGateProcedure">
    <Sequence>
      <RetryUntilSuccessful num_attempts="30">
        <Sequence>
          <SearchTarget label="gate"/>
          <SetDepth depth="1.1"/>
          <ApproachTarget label="gate" distance="3.5"/>
          <FinalAlignTarget label="gate"/>
        </Sequence>
      </RetryUntilSuccessful>
      <BlindForward duration="12.0" heading_lock="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="QualificationMission">
    <Sequence>
      <!-- WaitForStart is simulated by the decision node triggering BT tick based on topic -->
      <SetCamera mode="realsense"/>
      <SetDepth depth="0.7"/>
      
      <ReactiveFallback>
        <AvoidObstacle/>
        <SubTree ID="PassGateProcedure"/>
      </ReactiveFallback>

      <!-- Turn 180 degrees relative to current yaw -->
      <TurnToYaw degrees="180"/>

      <BlindForward duration="8.0" heading_lock="true"/>
      <SetDepth depth="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FinalMission">
    <Sequence>
      
      <SetCamera mode="realsense"/>
      <SetDepth depth="1.1"/>

      <ReactiveFallback>
        <AvoidObstacle sticky_time="1.0"/>
        <SubTree ID="PassGateProcedure"/>
      </ReactiveFallback>

      <SetDepth depth="0.5"/>
      <SubTree ID="TargetAcquisition"/>

      <SetCamera mode="realsense"/>
      <SetDepth depth="1.1"/>
      <SubTree ID="PassGateProcedure"/>
      
      <SubTree ID="CommunicationTask"/>

      <SetDepth depth="0.5"/>
      <SubTree ID="TargetReacquisition"/>

      <FinishMission/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TargetAcquisition">
    <Sequence>
      <SetCamera mode="realsense"/>
      <RetryUntilSuccessful num_attempts="60">
        <Sequence>
          <SearchTarget label="blue_drum"/>
          <ApproachTarget label="blue_drum" distance="4.0"/>
          <FinalAlignTarget label="blue_drum"/>
        </Sequence>
      </RetryUntilSuccessful>
      <SetCamera mode="usb"/>
      <MoveAboveTarget label="blue_drum"/>
      <DropBall/>
      <CheckBottomClear/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CommunicationTask">
    <Sequence>
      <WaitForFlareOrder/>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_1}"/>
              </Timeout>
              <ApproachTarget label="{flare_1}" distance="3.5"/>
              <FinalAlignTarget label="{flare_1}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_2}"/>
              </Timeout>
              <ApproachTarget label="{flare_2}" distance="3.5"/>
              <FinalAlignTarget label="{flare_2}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>

      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence>
              <Timeout msec="30000">
                <SearchTarget label="{flare_3}"/>
              </Timeout>
              <ApproachTarget label="{flare_3}" distance="3.5"/>
              <FinalAlignTarget label="{flare_3}"/>
            </Sequence>
          </RetryUntilSuccessful>
          <BumpFlare timeout="15.0"/>
        </Sequence>
        <SkipFlare/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TargetReacquisition">
    <Sequence>
      <SetCamera mode="realsense"/>
      <GoToPose pose_key="drop_pose"/>
      <SetCamera mode="usb"/>
      <RetryUntilSuccessful num_attempts="100">
        <Fallback>
          <Sequence>
            <SearchBottomTarget label="ball"/>
            <MoveAboveTarget label="ball"/>
            <ExtendArm/>
            <GrabBall/>
            <RetractArm/>
          </Sequence>
          <ForceFailure>
            <SpiralSearchBottom/>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

</root>
